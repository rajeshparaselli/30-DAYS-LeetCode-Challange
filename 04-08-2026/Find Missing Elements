class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        vector<int> ans;
        for(int i=nums[0];i<=nums[nums.size()-1];i++)
        {
            bool found = false;
            for(int j=0;j<nums.size();j++)
            {
                if(i==nums[j]) {found = true;break;}
            }
             if(!found) ans.push_back(i);
            
        }
        return ans;
    }
};
