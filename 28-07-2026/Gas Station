class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
        int totalcost =0,totalgas=0;
        int idx =0;
        int cg=0;
        for(int i=0;i<gas.size();i++)
        {
           
            totalcost+=cost[i];
            totalgas+=gas[i];
            cg+=gas[i]- cost[i];
            if(cg  <0)
            {
                cg=0;
                idx=i+1;
            }
        

        }
        if(totalgas<totalcost) return -1;

        return idx;
    }
};
