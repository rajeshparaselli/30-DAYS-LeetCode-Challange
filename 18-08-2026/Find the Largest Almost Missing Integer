class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {

        int n = nums.size();

        // Case 1: k == 1
        if (k == 1) {

            vector<int> freq(51, 0);

            for (int x : nums)
                freq[x]++;

            int ans = -1;

            for (int x = 0; x <= 50; x++) {
                if (freq[x] == 1)
                    ans = x;
            }

            return ans;
        }

        // Case 2: k == n
        if (k == n) {
            return *max_element(nums.begin(), nums.end());
        }

        // Case 3: 1 < k < n
        int first = nums[0];
        int last = nums[n - 1];

        vector<int> freq(51, 0);

        for (int x : nums)
            freq[x]++;

        int ans = -1;

        if (freq[first] == 1)
            ans = max(ans, first);

        if (freq[last] == 1)
            ans = max(ans, last);

        return ans;
    }
};
