class Solution {
public:
    int pro(int n)
    {
        int prod=1;
        while(n>0)
        {
            prod = prod * (n%10);
            n/=10;
        }
        return prod;
    }
    int smallestNumber(int n, int t) {
        
        

        for(int i=0;i<=10;i++)
        {
            if((pro(n+i)%t==0)) return n+i;
        }
        return 0;
    }
};
