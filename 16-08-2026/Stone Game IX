class Solution {
public:
    bool stoneGameIX(vector<int>& stones) {
        int cnt[3] = {0, 0, 0};

        for (int x : stones) {
            cnt[x % 3]++;
        }

        // If there are no remainder-1 or remainder-2 stones,
        // Alice cannot make the running sum non-zero and safe.
        if (cnt[1] == 0 && cnt[2] == 0)
            return false;

        // If cnt[0] is even, Alice wins when both types exist.
        if (cnt[0] % 2 == 0) {
            return cnt[1] > 0 && cnt[2] > 0;
        }

        // cnt[0] is odd:
        // Alice wins if one type has at least 2 more stones
        // than the other.
        return abs(cnt[1] - cnt[2]) > 2;
    }
};
