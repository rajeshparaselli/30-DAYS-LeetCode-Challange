class Solution {
public:
    vector<int> validSequence(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();

        // dp[i] = maximum length of a suffix of word2
        // that can be matched as a subsequence of word1[i...n-1]
        vector<int> dp(n + 1, 0);

        for (int i = n - 1; i >= 0; i--) {
            dp[i] = dp[i + 1];

            if (dp[i + 1] < m &&
                word1[i] == word2[m - dp[i + 1] - 1]) {
                dp[i]++;
            }
        }

        vector<int> ans;
        int j = 0;
        bool changed = false;

        for (int i = 0; i < n && j < m; i++) {

            // Case 1: Characters are equal.
            if (word1[i] == word2[j]) {
                ans.push_back(i);
                j++;
            }

            // Case 2: We can use this position as
            // the one allowed mismatch.
            else if (!changed) {
                // After choosing i, we need to match
                // word2[j+1 ... m-1].
                int remaining = m - j - 1;

                if (dp[i + 1] >= remaining) {
                    ans.push_back(i);
                    j++;
                    changed = true;
                }
            }
        }

        if (j == m)
            return ans;

        return {};
    }
};
